{% from "article-card.njk" import card %}
<section class="wrap hero">
  <h1 class="hero__title">Stats, math, sports, and whatever else I want to work on.</h1>
  <p class="hero__lede">
    Carney Journal is a personal collection of the projects I enjoy working on. You’ll find 
    a wide range of topics here, all in one place.
  </p>
</section>

<section class="wrap section">
  <div class="section__head">
    <h2>Latest</h2>
    <a href="/articles/">All articles &rarr;</a>
  </div>
  <div class="card-grid">
    {% for article in collections.articles | limit(6) %}
      {{ card(article) }}
    {% else %}
      <p class="empty">No articles yet.</p>
    {% endfor %}
  </div>
</section>
