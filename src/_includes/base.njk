<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{% if title %}{{ title }} · {{ site.title }}{% else %}{{ site.title }} — {{ site.tagline }}{% endif %}</title>
  <meta name="description" content="{{ description or site.tagline }}">
  <link rel="icon" href="/favicon.png" type="image/svg+xml">
  <link rel="stylesheet" href="/css/style.css">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Viga&family=Lexend:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
</head>
<body>
  <a class="skip-link" href="#main">Skip to content</a>

  <header class="masthead">
    <div class="wrap masthead__inner">
      <a class="masthead__logo" href="/">
        <img src="/images/logo.png" alt="{{ site.title }}">
      </a>
      <nav class="masthead__nav" aria-label="Primary">
        <ul>
          {% for item in site.nav %}
          <li><a href="{{ item.url }}"{% if page.url == item.url %} aria-current="page"{% endif %}>{{ item.text }}</a></li>
          {% endfor %}
          <li><a class="nav__donate" href="/donate/">Support</a></li>
        </ul>
      </nav>
    </div>
  </header>

  <main id="main">
    {{ content | safe }}
  </main>

  <footer class="site-footer">
    <div class="wrap site-footer__inner">
      <p>&copy; {{ currentYear }} {{ site.author }}. Built by hand with HTML, CSS, and a little statistics.</p>
      <p><a href="/contact/">Contact</a> &middot; <a href="/donate/">Support this journal</a></p>
    </div>
  </footer>
</body>
</html>
