{% from "article-card.njk" import card %}
<section class="wrap page-head">
  <p class="page-head__eyebrow">Archive</p>
  <h1>Articles</h1>
  <p class="page-head__lede">You can find all of my work right below.</p>
</section>

<section class="wrap section">
  <div class="card-grid">
    {% for article in collections.articles %}
      {{ card(article) }}
    {% else %}
      <p class="empty">This is niche. I haven't posted anything or I deleted it all.</p>
    {% endfor %}
  </div>
</section>
